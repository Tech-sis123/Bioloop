# Copy to .env for local development (node --env-file=.env src/index.js)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bioloop
DATABASE_SSL=false

# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-change-me-now

# Web app address(es) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# First admin account (created on boot if no admin exists)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMe123

# Optional
SEED_DEMO=false
RESEND_API_KEY=
MAIL_FROM=BioLoop <onboarding@resend.dev>
CROSS_SITE_COOKIES=false
TRUST_PROXY=1
LOW_BATTERY_PCT=20
OFFLINE_AFTER_MULTIPLIER=3
READING_RETENTION_DAYS=180
