# Leave VITE_API_URL empty to use the /api proxy in vercel.json (recommended).
# Only set it if the web app should call the API directly (then set CROSS_SITE_COOKIES=true on the API).
VITE_API_URL=

# The API address shown to the IoT engineer next to new device keys.
# Set this to your Render URL so sensors talk to the API directly.
VITE_DEVICE_API_URL=https://bioloop-api.onrender.com
